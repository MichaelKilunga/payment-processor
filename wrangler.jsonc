{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payment-processor",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Every 5 minutes: expire transactions that stayed "pending" past the configured timeout.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Cloudflare Rate Limiting bindings (period must be 10 or 60 seconds).
  // The code falls back to a per-isolate in-memory limiter when these are absent (e.g. older wrangler).
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payment-processor-db",
      "database_id": "36938229-9ed6-4998-b779-578340052bef"
    }
  ]
}
